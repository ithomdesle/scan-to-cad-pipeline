{
  "outputDirectory": "./output",
  "meshCleaning": {
    "targetTriangleCount": 100000,
    "simplificationErrorTolerance": 0.01,
    "smallComponentAreaFraction": 0.01,
    "isFillHolesEnabled": true,
    "weldingTolerance": 0.00001
  },
  "featureExtraction": {
    "segmentationAngleToleranceDegrees": 30,
    "planarDistanceTolerance": 0.25,
    "minimumFaceAreaFraction": 0.01,
    "maximumCylinderFitResidualFraction": 0.08
  },
  "cadGeneration": {
    "isLanguageModelEnabled": true,
    "maximumAttempts": 3,
    "languageModel": {
      "endpoint": "http://127.0.0.1:1234/v1",
      "model": "local-model",
      "temperature": 0.2,
      "maximumTokens": 2000,
      "timeoutMilliseconds": 120000
    }
  },
  "stepExport": {
    "schema": "ap214",
    "timeoutMilliseconds": 300000
  }
}
