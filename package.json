{
  "name": "scan-to-cad-pipeline",
  "version": "2.0.0",
  "description": "Automated pipeline: 3D scan (STL/OBJ) \u2192 feature extraction \u2192 build123d model \u2192 STEP for Onshape",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "scan2cad": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "lint": "eslint src",
    "setup:python": "bash scripts/setup-python-environment.sh",
    "clean": "rm -rf dist",
    "build:web": "cd web && npx tsc -b && npx vite build",
    "build:all": "npm run build && npm run build:web",
    "serve": "node dist/server.js"
  },
  "keywords": [
    "cad",
    "step",
    "onshape",
    "photogrammetry",
    "build123d",
    "3d-scanning"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "commander": "^12.1.0",
    "fastify": "^5.12.5",
    "meshoptimizer": "^0.21.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.11.19",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
